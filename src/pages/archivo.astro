---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { url } from '../utils';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.borrador)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---
<BaseLayout titulo="Archivo" descripcion="Todas las publicaciones de Administración Pública HN.">
  <div class="contenedor arch">
    <header class="arch__header">
      <a class="arch__volver" href={url('/')}>← Inicio</a>
      <h1>Archivo</h1>
      <p>Todas las publicaciones, de la más reciente a la más antigua.</p>
    </header>
    <div class="grilla grilla--3">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .arch { padding: 2.6rem 0 1rem; }
  .arch__header { max-width: var(--ancho-texto); margin-bottom: 2.2rem; }
  .arch__volver { font-weight: 600; font-size: .9rem; }
  .arch__header h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: .6rem 0 .3rem; }
  .arch__header p { color: var(--texto-tenue); font-size: 1.05rem; margin: 0; }
</style>
