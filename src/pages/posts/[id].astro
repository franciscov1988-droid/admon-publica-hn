---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Suscripcion from '../../components/Suscripcion.astro';
import { url, fechaLarga, categoriaSlug } from '../../utils';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.borrador);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const etiquetaOro = data.categoria === 'Políticas públicas';
---
<BaseLayout titulo={data.titulo} descripcion={data.descripcion} imagen={data.portada} tipo="article">
  <article class="articulo">
    <div class="contenedor articulo__cabecera">
      <a class={`etiqueta ${etiquetaOro ? 'etiqueta--oro' : ''}`} href={url(`/categoria/${categoriaSlug(data.categoria)}`)}>
        {data.categoria}
      </a>
      <h1>{data.titulo}</h1>
      {data.descripcion && <p class="articulo__bajada">{data.descripcion}</p>}
      <p class="articulo__meta">Por <strong>{data.autor}</strong> · {fechaLarga(data.fecha)}</p>
    </div>

    {data.portada && (
      <div class="contenedor articulo__portada">
        <img src={data.portada} alt={data.titulo} loading="eager" />
      </div>
    )}

    <div class="articulo__cuerpo">
      <div class="prosa">
        <Content />
      </div>

      <div class="articulo__pie">
        <a class="volver" href={url('/archivo')}>← Volver al archivo</a>
      </div>
    </div>

    <div class="contenedor articulo__susc">
      <Suscripcion variante="compacto" />
    </div>
  </article>
</BaseLayout>

<style>
  .articulo__cabecera { max-width: var(--ancho-texto); margin: 3rem auto 1.4rem; text-align: left; }
  .articulo__cabecera h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); margin: .7rem 0 .4rem; }
  .articulo__bajada { font-size: 1.2rem; color: var(--texto-tenue); font-family: var(--serif); font-style: italic; margin: 0 0 .9rem; }
  .articulo__meta { font-size: .92rem; color: var(--texto-tenue); margin: 0; }
  .articulo__meta strong { color: var(--azul-800); }

  .articulo__portada { max-width: 980px; margin: 1.5rem auto 0; }
  .articulo__portada img { width: 100%; border-radius: var(--radio); box-shadow: var(--sombra); aspect-ratio: 16/8; object-fit: cover; }

  .articulo__cuerpo { width: min(100% - 2.4rem, var(--ancho-texto)); margin: 2.4rem auto 0; }
  .articulo__pie { margin-top: 2.6rem; padding-top: 1.4rem; border-top: 1px solid var(--borde); }
  .volver { font-weight: 600; }

  .articulo__susc { max-width: 880px; margin: 3rem auto 0; }
</style>
