---
import data from '../data/frases.json';
const frases = data.frases;
---
<section class="frases" aria-label="Frases destacadas" data-frases-wrap>
  <div class="contenedor frases__inner">
    <svg class="frases__comillas" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d="M9.5 6C6.46 6 4 8.46 4 11.5V18h6v-6H7.5c0-1.38 1.12-2.5 2.5-2.5V6Zm10 0C16.46 6 14 8.46 14 11.5V18h6v-6h-2.5c0-1.38 1.12-2.5 2.5-2.5V6Z"/>
    </svg>

    <div class="frases__pista" data-frases-track>
      {frases.map((f, i) => (
        <figure class="frase" data-frase data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <blockquote>{f.texto}</blockquote>
          {f.autor && <figcaption>— {f.autor}</figcaption>}
        </figure>
      ))}
    </div>

    <div class="frases__controles">
      <button class="frases__flecha" data-frases-prev aria-label="Frase anterior">‹</button>
      <div class="frases__puntos" data-frases-dots role="tablist">
        {frases.map((_, i) => (
          <button class="frases__punto" data-frases-dot data-index={i} aria-label={`Frase ${i + 1}`}></button>
        ))}
      </div>
      <button class="frases__flecha" data-frases-next aria-label="Frase siguiente">›</button>
    </div>
  </div>
</section>

<style>
  .frases {
    background: linear-gradient(135deg, var(--azul-900) 0%, var(--azul-700) 55%, var(--azul-600) 100%);
    color: #fff; position: relative; overflow: hidden;
  }
  .frases::before {
    content: ""; position: absolute; inset: 0;
    background:
      radial-gradient(1200px 300px at 90% -20%, rgba(212,166,42,.22), transparent 60%),
      radial-gradient(900px 260px at -10% 120%, rgba(39,90,158,.5), transparent 60%);
    pointer-events: none;
  }
  .frases__inner { position: relative; padding: 2.6rem 0 2rem; text-align: center; }
  .frases__comillas { width: 46px; height: 46px; color: var(--oro-500); opacity: .9; margin: 0 auto .4rem; display: block; }

  .frases__pista { position: relative; min-height: 118px; display: grid; }
  .frase {
    grid-area: 1 / 1; margin: 0; max-width: 760px; margin-inline: auto;
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity .5s ease, transform .5s ease; pointer-events: none;
  }
  .frase[data-activa] { opacity: 1; visibility: visible; transform: none; }
  .frase blockquote {
    font-family: var(--serif); font-size: clamp(1.15rem, 2.6vw, 1.6rem); line-height: 1.4;
    font-weight: 500; margin: 0 0 .7rem; color: #fff;
  }
  .frase figcaption { color: var(--oro-100); font-weight: 600; font-size: .92rem; letter-spacing: .02em; }

  .frases__controles { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 1rem; }
  .frases__flecha {
    width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.3);
    background: rgba(255,255,255,.06); color: #fff; font-size: 1.4rem; line-height: 1; cursor: pointer;
    transition: .18s; display: grid; place-items: center; padding-bottom: 3px;
  }
  .frases__flecha:hover { background: var(--oro-500); color: var(--azul-900); border-color: var(--oro-500); }
  .frases__puntos { display: flex; gap: .5rem; }
  .frases__punto {
    width: 9px; height: 9px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
    background: rgba(255,255,255,.3); transition: .2s;
  }
  .frases__punto[data-activa] { background: var(--oro-500); transform: scale(1.3); }
</style>

<script>
  const wrap = document.querySelector('[data-frases-wrap]');
  if (wrap) {
    const frases = Array.from(wrap.querySelectorAll('[data-frase]'));
    const dots = Array.from(wrap.querySelectorAll('[data-frases-dot]'));
    const prev = wrap.querySelector('[data-frases-prev]');
    const next = wrap.querySelector('[data-frases-next]');
    // Orden aleatorio en cada carga
    const orden = frases.map((_, i) => i).sort(() => Math.random() - 0.5);
    let pos = 0;
    let timer;

    function mostrar(p) {
      pos = (p + orden.length) % orden.length;
      const idx = orden[pos];
      frases.forEach((f, i) => f.toggleAttribute('data-activa', i === idx));
      frases.forEach((f, i) => f.setAttribute('aria-hidden', i === idx ? 'false' : 'true'));
      dots.forEach((d, i) => d.toggleAttribute('data-activa', i === idx));
    }
    function auto() { clearInterval(timer); timer = setInterval(() => mostrar(pos + 1), 6500); }

    prev?.addEventListener('click', () => { mostrar(pos - 1); auto(); });
    next?.addEventListener('click', () => { mostrar(pos + 1); auto(); });
    dots.forEach((d) => d.addEventListener('click', () => {
      const idx = Number(d.getAttribute('data-index'));
      pos = orden.indexOf(idx); mostrar(pos); auto();
    }));
    wrap.addEventListener('mouseenter', () => clearInterval(timer));
    wrap.addEventListener('mouseleave', auto);

    mostrar(0); auto();
  }
</script>
