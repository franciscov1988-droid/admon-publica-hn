---
import site from '../data/site.json';
import { url } from '../utils';
const { variante = 'completo' } = Astro.props;
---
<section class={`susc ${variante === 'compacto' ? 'susc--compacto' : ''}`}>
  <div class="susc__icono" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>
    </svg>
  </div>
  <div class="susc__texto">
    <h3>Recibe las publicaciones en tu correo</h3>
    <p>Suscríbete y te llegará cada nuevo análisis sobre administración pública y políticas públicas en Honduras.</p>
  </div>
  <form class="susc__form" action={site.suscripcion_form} method="post" target="_blank">
    <input type="email" name="email" required placeholder="tucorreo@ejemplo.com" aria-label="Correo electrónico" />
    <button class="boton boton--oro" type="submit">Suscribirme</button>
  </form>
  <p class="susc__nota">
    Sin spam. También puedes seguirnos en
    <a href={site.facebook} target="_blank" rel="noopener">Facebook</a>
    o vía <a href={url('/rss.xml')}>RSS</a>.
  </p>
</section>

<style>
  .susc {
    background: linear-gradient(135deg, var(--azul-900), var(--azul-700));
    color: #fff; border-radius: var(--radio); padding: 2.2rem 2rem;
    display: grid; gap: .5rem; text-align: center; box-shadow: var(--sombra);
    position: relative; overflow: hidden;
  }
  .susc::after {
    content: ""; position: absolute; inset: auto -40px -60px auto; width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(212,166,42,.35), transparent 70%); pointer-events: none;
  }
  .susc__icono {
    width: 58px; height: 58px; margin: 0 auto; display: grid; place-items: center;
    background: rgba(255,255,255,.12); border-radius: 50%; color: var(--oro-500);
  }
  .susc__texto h3 { color: #fff; font-size: 1.5rem; margin: .3rem 0 .2rem; }
  .susc__texto p { color: rgba(255,255,255,.82); margin: 0 auto .6rem; max-width: 46ch; font-size: .98rem; }
  .susc__form { display: flex; gap: .55rem; max-width: 460px; margin: .4rem auto 0; flex-wrap: wrap; }
  .susc__form input {
    flex: 1 1 220px; min-width: 0; padding: .78rem 1rem; border-radius: 999px; border: 0;
    font: inherit; font-size: .95rem; color: var(--tinta);
  }
  .susc__form input:focus { outline: 3px solid rgba(212,166,42,.5); }
  .susc__form .boton { flex: 0 0 auto; }
  .susc__nota { color: rgba(255,255,255,.7); font-size: .82rem; margin: .8rem 0 0; }
  .susc__nota a { color: var(--oro-100); text-decoration: underline; }

  .susc--compacto { padding: 1.6rem 1.4rem; }
  .susc--compacto .susc__texto h3 { font-size: 1.2rem; }
  .susc--compacto .susc__texto p { font-size: .9rem; }
</style>
