---
import site from '../data/site.json';
import { url } from '../utils';
const anio = new Date().getFullYear();
---
<footer class="pie">
  <div class="contenedor pie__grid">
    <div class="pie__marca">
      <img src={url('/images/logo.jpg')} alt="Administración Pública HN" width="64" height="64" />
      <div>
        <strong>Administración Pública HN</strong>
        <p>{site.lema}</p>
      </div>
    </div>

    <nav class="pie__nav" aria-label="Enlaces del pie">
      <h4>Secciones</h4>
      <a href={url('/')}>Inicio</a>
      <a href={url('/categoria/opiniones')}>Opiniones</a>
      <a href={url('/categoria/politicas-publicas')}>Políticas públicas</a>
      <a href={url('/archivo')}>Archivo</a>
      <a href={url('/acerca')}>Acerca de</a>
    </nav>

    <div class="pie__redes">
      <h4>Síguenos</h4>
      <a class="pie__fb" href={site.facebook} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"/>
        </svg>
        Facebook
      </a>
      <a class="pie__rss" href={url('/rss.xml')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11Zm0 4a5 5 0 0 1 5 5h2.5A7.5 7.5 0 0 0 4 12.5V15Zm1.8 5a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Z"/>
        </svg>
        RSS
      </a>
    </div>
  </div>
  <div class="pie__base">
    <div class="contenedor">
      © {anio} Administración Pública HN · Tegucigalpa, Honduras · «Servicio, transparencia y desarrollo».
    </div>
  </div>
</footer>

<style>
  .pie { background: var(--azul-900); color: rgba(255,255,255,.82); margin-top: 4rem; }
  .pie__grid {
    display: grid; gap: 2rem; padding: 3rem 0 2.2rem;
    grid-template-columns: 1.6fr 1fr 1fr;
  }
  .pie__marca { display: flex; gap: .9rem; align-items: flex-start; }
  .pie__marca img { border-radius: 50%; }
  .pie__marca strong { font-family: var(--serif); color: #fff; font-size: 1.1rem; display: block; }
  .pie__marca p { margin: .25rem 0 0; font-size: .88rem; max-width: 34ch; }
  .pie h4 { color: var(--oro-500); font-family: var(--sans); font-size: .76rem; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 .9rem; }
  .pie__nav { display: flex; flex-direction: column; gap: .5rem; }
  .pie__nav a, .pie__redes a { color: rgba(255,255,255,.82); font-size: .95rem; }
  .pie__nav a:hover, .pie__redes a:hover { color: var(--oro-100); }
  .pie__redes { display: flex; flex-direction: column; gap: .7rem; align-items: flex-start; }
  .pie__fb, .pie__rss { display: inline-flex; align-items: center; gap: .5rem; }
  .pie__base { border-top: 1px solid rgba(255,255,255,.12); padding: 1.1rem 0; font-size: .82rem; color: rgba(255,255,255,.6); }
  @media (max-width: 760px) { .pie__grid { grid-template-columns: 1fr; gap: 1.6rem; } }
</style>
