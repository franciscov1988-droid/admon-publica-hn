---
import { url, fechaLarga, categoriaSlug } from '../utils';

const { post, destacar = false } = Astro.props;
const { data, id } = post;
const enlace = url(`/posts/${id}`);
const etiquetaOro = data.categoria === 'Políticas públicas';
---
<article class={`tarjeta ${destacar ? 'tarjeta--destacada' : ''}`}>
  <a class="tarjeta__img" href={enlace} aria-hidden="true" tabindex="-1">
    {data.portada
      ? <img src={data.portada} alt="" loading="lazy" />
      : <div class="tarjeta__ph"><img src={url('/images/logo.jpg')} alt="" width="80" height="80" /></div>}
  </a>
  <div class="tarjeta__cuerpo">
    <a class={`etiqueta ${etiquetaOro ? 'etiqueta--oro' : ''}`} href={url(`/categoria/${categoriaSlug(data.categoria)}`)}>
      {data.categoria}
    </a>
    <h3><a href={enlace}>{data.titulo}</a></h3>
    {data.descripcion && <p class="tarjeta__desc">{data.descripcion}</p>}
    <p class="tarjeta__meta"><strong>{data.autor}</strong> · {fechaLarga(data.fecha)}</p>
  </div>
</article>

<style>
  .tarjeta {
    background: #fff; border: 1px solid var(--borde); border-radius: var(--radio);
    overflow: hidden; display: flex; flex-direction: column;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .tarjeta:hover { transform: translateY(-3px); box-shadow: var(--sombra); border-color: #d6deea; }
  .tarjeta__img { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--papel-3); }
  .tarjeta__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .tarjeta:hover .tarjeta__img img { transform: scale(1.04); }
  .tarjeta__ph { width: 100%; height: 100%; display: grid; place-items: center; background: var(--azul-050); }
  .tarjeta__ph img { border-radius: 50%; opacity: .85; }
  .tarjeta__cuerpo { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: .55rem; flex: 1; }
  .tarjeta__cuerpo h3 { font-size: 1.22rem; margin: 0; }
  .tarjeta__cuerpo h3 a { color: var(--azul-900); }
  .tarjeta__cuerpo h3 a:hover { color: var(--azul-700); }
  .tarjeta__desc { color: var(--texto-tenue); font-size: .95rem; margin: 0; }
  .tarjeta__meta { color: var(--texto-tenue); font-size: .82rem; margin: auto 0 0; }
  .tarjeta__meta strong { color: var(--azul-800); }

  /* Variante destacada (hero) */
  .tarjeta--destacada { flex-direction: row; grid-column: 1 / -1; }
  .tarjeta--destacada .tarjeta__img { flex: 1 1 55%; aspect-ratio: auto; min-height: 320px; }
  .tarjeta--destacada .tarjeta__cuerpo { flex: 1 1 45%; justify-content: center; padding: 2rem 2.2rem; gap: .8rem; }
  .tarjeta--destacada h3 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); }
  .tarjeta--destacada .tarjeta__desc { font-size: 1.05rem; }
  @media (max-width: 820px) {
    .tarjeta--destacada { flex-direction: column; }
    .tarjeta--destacada .tarjeta__img { min-height: 220px; aspect-ratio: 16/9; }
    .tarjeta--destacada .tarjeta__cuerpo { padding: 1.3rem 1.3rem 1.5rem; }
  }
</style>
